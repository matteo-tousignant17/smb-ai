generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth (NextAuth v5) ─────────────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Business ────────────────────────────────────────────────────────────────

model Business {
  id          String  @id @default(cuid())
  name        String
  type        String  @default("both")
  industry    String?
  description String?
  logo        String?
  address     String?
  city        String?
  state       String?
  zip         String?
  phone       String?
  email       String?
  website     String?
  currency    String  @default("USD")
  timezone    String  @default("America/New_York")
  taxRate     Float   @default(0)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  customers    Customer[]
  jobs         Job[]
  invoices     Invoice[]
  leads        Lead[]
  quotes       Quote[]
  products     Product[]
  expenses     Expense[]
  integrations BusinessIntegration[]
  aiInsights   AiInsight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  name       String
  company    String?
  email      String?
  phone      String?
  address    String?
  city       String?
  state      String?
  zip        String?
  type       String   @default("business")
  notes      String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  jobs     Job[]
  invoices Invoice[]
  leads    Lead[]
  quotes   Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Lead / Pipeline ─────────────────────────────────────────────────────────

model Lead {
  id          String    @id @default(cuid())
  title       String
  stage       String    @default("new")
  value       Float?
  source      String?
  probability Int       @default(50)
  notes       String?
  lostReason  String?
  followUpAt  DateTime?
  closedAt    DateTime?
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Quote ───────────────────────────────────────────────────────────────────

model Quote {
  id         String    @id @default(cuid())
  number     String
  status     String    @default("draft")
  validUntil DateTime?
  notes      String?
  subtotal   Float     @default(0)
  taxRate    Float     @default(0)
  tax        Float     @default(0)
  total      Float     @default(0)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items QuoteItem[]
  job   Job?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteItem {
  id          String @id @default(cuid())
  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  type        String @default("service")
  productId   String?
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ─── Job / Work Order ────────────────────────────────────────────────────────

model Job {
  id           String    @id @default(cuid())
  title        String
  jobNumber    String?
  status       String    @default("scheduled")
  priority     String    @default("normal")
  startDate    DateTime?
  endDate      DateTime?
  location     String?
  notes        String?
  laborCost    Float     @default(0)
  materialCost Float     @default(0)
  billedAmount Float     @default(0)
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  quoteId      String?   @unique
  quote        Quote?    @relation(fields: [quoteId], references: [id])

  items    JobItem[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobItem {
  id          String @id @default(cuid())
  description String
  quantity    Float  @default(1)
  unitCost    Float  @default(0)
  total       Float  @default(0)
  type        String @default("material")
  productId   String?
  jobId       String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id         String    @id @default(cuid())
  number     String
  status     String    @default("draft")
  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  paidAt     DateTime?
  subtotal   Float     @default(0)
  taxRate    Float     @default(0)
  tax        Float     @default(0)
  total      Float     @default(0)
  notes      String?
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  total       Float   @default(0)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ─── Product / Inventory ─────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String?
  description String?
  type        String   @default("product")
  unitCost    Float    @default(0)
  unitPrice   Float    @default(0)
  unit        String   @default("each")
  stockLevel  Int      @default(0)
  minStock    Int      @default(0)
  category    String?
  supplier    String?
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  stockTransactions StockTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockTransaction {
  id        String  @id @default(cuid())
  type      String
  quantity  Int
  notes     String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  jobId     String?

  createdAt DateTime @default(now())
}

// ─── Expense ─────────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String   @default("general")
  date        DateTime @default(now())
  vendor      String?
  notes       String?
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Integration ─────────────────────────────────────────────────────────────

model BusinessIntegration {
  id         String   @id @default(cuid())
  type       String
  status     String   @default("disconnected")
  config     String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, type])
}

// ─── AI Insights ─────────────────────────────────────────────────────────────

model AiInsight {
  id         String   @id @default(cuid())
  type       String
  priority   String   @default("medium")
  title      String
  body       String
  data       String?
  dismissed  Boolean  @default(false)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
